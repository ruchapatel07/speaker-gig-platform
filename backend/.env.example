# Backend Server Configuration
PORT=5000

# MongoDB Connection URL & Database
MONGODB_URI=mongodb://127.0.0.1:27017/speakhub
MONGODB_DB_NAME=speakhub

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Allowed Frontend URL for CORS (Production)
FRONTEND_URL=https://speaker-gig-platform.onrender.com

# Optional PostgreSQL Database Configuration (if using relational storage)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=speaker_gig
